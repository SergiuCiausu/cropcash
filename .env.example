# Stripe — DOAR chei de test (sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# Claude API (citirea hârtiilor: facturi, cererea și decizia APIA; radar de fonduri). Fără cheie, butoanele răspund „Acum nu putem citi hârtii”.
ANTHROPIC_API_KEY=sk-ant-xxx
# The assistant ("Întreabă"): model, and messages per farmer per day. Both optional.
ANTHROPIC_MODEL=claude-sonnet-5-5
ASSISTANT_DAILY_LIMIT=5

# Frontend (Netlify) — publice, ajung în build
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxx
VITE_API_URL=https://api.cropcash.ro

# API (VPS)
PORT=3001
CORS_ORIGINS=https://cropcash.netlify.app,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# Parametri (opționali)
DEMO_MODE=true
VITE_DEMO_MODE=true

# Harta (opțional): cheia MapTiler pentru butonul „Satelit”. E publică (ajunge în browser), deci restrânge-o
# pe domeniul aplicației în contul MapTiler. Fără ea, harta nu are „Satelit”.
VITE_MAPTILER_KEY=

# Vremea (opționale). Fără ele, API-ul folosește serviciul gratuit Open-Meteo.
# Plan plătit: OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com + OPEN_METEO_API_KEY.
# Instanță proprie: vezi open-meteo-vps-setup.md.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=

# Supabase — conexiunea directă la Postgres (pentru migrații)
SUPABASE_DB_URL=postgresql://postgres.xxx:PAROLA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Web: show the demo controls (simulated APIA payment, moving time)
VITE_DEMO_MODE=true

# Demo account for the pitch (npm run seed:demo)
DEMO_EMAIL=ion@cropcash.test
DEMO_PASSWORD=schimba-ma

# Goes in the User-Agent when the API reads a farmer's source. Optional.
CONTACT_EMAIL=

# Extra people who may add fertilizers to the catalogue (comma-separated sign-in emails). The admins
# (ADMIN_EMAILS) always may; this is for someone who should edit the catalogue but not the forecasts.
CATALOGUE_EDITORS=

# Who may open the admin panel and change the figures behind the forecasts, and add fertilizers (comma-separated sign-in emails).
# Unset = DEMO_EMAIL only. See docs/admin-panel-plan.md.
ADMIN_EMAILS=
# How often (seconds) the API rereads the published changes, for a publish made by another API process. Default 300.
PREDICTIONS_REFRESH_S=

# Where the API keeps APIA bloc answers (30 days). Optional; defaults to a folder in the system temp dir.
LPIS_CACHE_DIR=
