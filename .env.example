# Stripe — DOAR chei de test (sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# Claude API (citirea hârtiilor: facturi, cererea și decizia APIA; radar de fonduri). Fără cheie, butoanele răspund „Acum nu putem citi hârtii”.
ANTHROPIC_API_KEY=sk-ant-xxx
# The assistant ("Întreabă"): model, and messages per farmer per day. Both optional.
ANTHROPIC_MODEL=claude-sonnet-5-5
ASSISTANT_DAILY_LIMIT=40

# Frontend (Netlify) — publice, ajung în build
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxx
VITE_API_URL=https://api.cropcash.ro

# API (VPS)
PORT=3001
CORS_ORIGINS=https://cropcash.netlify.app,http://localhost:5173

# Parametri (opționali)
DEMO_MODE=true
VITE_DEMO_MODE=true

# Vremea (opționale). Fără ele, API-ul folosește serviciul gratuit Open-Meteo.
# Plan plătit: OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com + OPEN_METEO_API_KEY.
# Instanță proprie: vezi open-meteo-vps-setup.md.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=

# Supabase — conexiunea directă la Postgres (pentru migrații)
SUPABASE_DB_URL=postgresql://postgres.xxx:PAROLA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Web: show the demo controls (simulated APIA payment, moving time)
VITE_DEMO_MODE=true

# Demo account for the pitch (npm run seed:demo)
DEMO_EMAIL=ion@cropcash.test
DEMO_PASSWORD=schimba-ma

# Goes in the User-Agent when the API reads a farmer's source. Optional.
CONTACT_EMAIL=
