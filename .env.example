# Stripe — DOAR chei de test (sk_test_...)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx

# Claude API (citirea hârtiilor: facturi, cererea și decizia APIA; radar de fonduri). Fără cheie, butoanele răspund „Acum nu putem citi hârtii”.
ANTHROPIC_API_KEY=sk-ant-xxx
# The assistant ("Întreabă"): model, and messages per farmer per day. Both optional.
ANTHROPIC_MODEL=claude-sonnet-5-5
ASSISTANT_DAILY_LIMIT=5

# Frontend (Netlify) — publice, ajung în build
VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxx
VITE_API_URL=https://api.cropcash.ro

# API (VPS)
PORT=3001
CORS_ORIGINS=https://cropcash.netlify.app,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178

# Facturi (docs/facturi-plan.md): cheia cu care se sigilează cheile Oblio ale fermelor. 32 de octeți, base64:
#   openssl rand -base64 32
# Fără ea, ferma nu se poate lega de Oblio (facturile merg doar pe simulator). Odată pusă, nu o schimba:
# cheile deja salvate nu s-ar mai deschide și fermele ar trebui să lege Oblio din nou.
INVOICING_KEY=

# test:oblio (opțional, doar pentru verificarea API-ului Oblio pe un cont de probă; vezi scripts/test-oblio.ts)
OBLIO_EMAIL=
OBLIO_SECRET=
OBLIO_CIF=

# ANAF e-Factura direct (docs/facturi-plan.md pasul 8). Aplicația se înregistrează la ANAF (Servicii online >
# Înregistrare utilizatori > Dezvoltatori aplicații), cu callback-ul https://<api>/api/anaf/callback. Fără ele (și fără
# INVOICING_KEY) nu se poate lega SPV; PDF-ul de la ANAF merge oricum.
ANAF_CLIENT_ID=
ANAF_CLIENT_SECRET=
ANAF_REDIRECT_URI=
# npm run test:efactura: o fermă legată prin „Conectează SPV” (opțional) și EFACTURA_UPLOAD=1 ca să trimită o factură de probă la sistemul de test ANAF.
EFACTURA_FARM_ID=
# Pasul 9: „true” (exact) lasă fermele să treacă pe gazda de producție ANAF, după o probă reușită pe test. Gol = doar test.
INVOICING_ALLOW_PROD=
# Cât de des API-ul trece singur prin fermele legate (secunde). Gol = din docs/data/anaf-efactura.json; 0 = oprit.
INVOICING_POLL_S=

# Parametri (opționali)
DEMO_MODE=true
VITE_DEMO_MODE=true

# Harta (opțional): cheia MapTiler pentru butonul „Satelit”. E publică (ajunge în browser), deci restrânge-o
# pe domeniul aplicației în contul MapTiler. Fără ea, harta nu are „Satelit”.
VITE_MAPTILER_KEY=

# Harta Google (opțional, docs/cerere-documents-google-map-plan.md §8): vederea 3D, harta din satelit și desenul.
# Amândouă sau niciuna: harta 3D și colțurile care se trag au nevoie de Map ID. Cheia e publică (ajunge în
# browser): în Google Cloud Console restrânge-o pe HTTP referrer (domeniul Netlify și localhost:5173) și doar la
# Maps JavaScript API, apoi pune o alertă de buget și o limită zilnică (G12). Fără ele, harta rămâne cea de acum.
VITE_GOOGLE_MAPS_KEY=
VITE_GOOGLE_MAP_ID=

# Vremea (opționale). Fără ele, API-ul folosește serviciul gratuit Open-Meteo.
# Plan plătit: OPEN_METEO_BASE_URL=https://customer-api.open-meteo.com + OPEN_METEO_API_KEY.
# Instanță proprie: vezi open-meteo-vps-setup.md.
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_API_KEY=

# Supabase — conexiunea directă la Postgres (pentru migrații)
SUPABASE_DB_URL=postgresql://postgres.xxx:PAROLA@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Web: show the demo controls (simulated APIA payment, moving time)
VITE_DEMO_MODE=true

# Demo account for the pitch (npm run seed:demo)
DEMO_EMAIL=ion@cropcash.test
DEMO_PASSWORD=schimba-ma

# Goes in the User-Agent when the API reads a farmer's source. Optional.
CONTACT_EMAIL=

# Admins and fertilizer editors are not set here: they're rows in the app_roles table in Supabase
# (migration 035). See docs/admin-opportunities-plan.md. ADMIN_EMAILS and CATALOGUE_EDITORS are no longer read.
# How often (seconds) the API rereads the published changes, for a publish made by another API process. Default 300.
PREDICTIONS_REFRESH_S=

# Where the API keeps APIA bloc answers (30 days). Optional; defaults to a folder in the system temp dir.
LPIS_CACHE_DIR=
