{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noUncheckedIndexedAccess": false,
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "app", "components", "lib", "legacy", "next.config.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "out"]
}
