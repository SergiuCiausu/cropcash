{
  "name": "cropcash",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "subventii-monitor"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c green,blue \"npm run dev -w @cropcash/web\" \"npm run dev -w @cropcash/api\"",
    "build": "npm run build -w @cropcash/web && npm run build -w @cropcash/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "test:integration": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:stripe": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config vitest.stripe.config.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.7",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
