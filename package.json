{
  "name": "cropcash",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "subventii-monitor",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,blue \"npm run dev -w @cropcash/next\" \"npm run dev -w @cropcash/api\"",
    "build": "npm run build -w @cropcash/next && npm run build -w @cropcash/api",
    "build:web": "npm run build -w @cropcash/next",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:questions": "node ./node_modules/tsx/dist/cli.mjs scripts/verify-questions.ts",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "test:integration": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "test:stripe": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config vitest.stripe.config.ts",
    "test:oblio": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/test-oblio.ts",
    "test:efactura": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs scripts/test-efactura.ts",
    "test:assistant": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --config vitest.assistant.config.ts",
    "seed:demo": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/seed-demo.ts",
    "documents:sweep": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/sweep-documents.ts",
    "seed:fertilizers": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/seed-fertilizers.ts",
    "demo:rehearse": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/rehearse-demo.ts",
    "admin:rehearse": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/rehearse-admin.ts",
    "admin:grant": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/admin-roles.ts grant",
    "admin:revoke": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/admin-roles.ts revoke",
    "admin:list": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/admin-roles.ts list",
    "geo:siruta": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs scripts/import-geo/siruta.ts",
    "geo:lpis": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs scripts/import-geo/lpis.ts",
    "geo:import": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs scripts/import-geo/siruta.ts --db && node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs scripts/import-geo/lpis.ts --db && node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs scripts/import-geo/reconcile.ts",
    "weather:climatology": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs scripts/build-rain-climatology.ts",
    "pensions:stop": "node --env-file=.env ./node_modules/tsx/dist/cli.mjs scripts/stop-pensions.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.7",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
